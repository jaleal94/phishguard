# Copie este archivo a .env y complete los valores. Nunca suba .env al repositorio.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://phishguard.vercel.app

# Si se deja vacío, se usa SQLite local (solo desarrollo).
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=phishguard

# Si EMAIL_HOST está vacío, los correos se imprimen en consola.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PhishGuard <no-responder@curex.net.ve>

CRON_SECRET=
SITE_URL=https://phishguard.vercel.app
