{
  "builds": [
    {
      "src": "phishguard/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb" }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "phishguard/wsgi.py" }
  ],
  "crons": [
    { "path": "/cron/enviar-campanas/", "schedule": "0 13 * * *" }
  ]
}
